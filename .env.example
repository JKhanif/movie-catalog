# PostgreSQL (для Docker-совместимости)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=movie_catalog
POSTGRES_PORT=5432
POSTGRES_VERSION=16

# Подключение к БД
DATABASE_URL=postgres://user:password@localhost:5432/movie_catalog?sslmode=disable

# Админ-токен (заголовок Authorization: Bearer <token>)
ADMIN_TOKEN=your-secret-admin-token

# Порт сервера
PORT=8080
